<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Голосовые (docs/PROMPT.md, 11.3): спрашивается при первой записи, не при запуске. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
        Кружки (docs/PROMPT.md, 11.4): камера для записи видеосообщения, спрашивается при первой записи.
        Не обязательна: без камеры приложение ставится и работает, кружок просто нечем записать.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <!-- «Место»: одна точка по просьбе человека, из видимого приложения. Фоновой геопозиции нет. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Уведомления (docs/PROMPT.md, 10.5): спрашивается после первого входа, не на экране входа. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Отправка видео, альбома и большого файла (docs/PROMPT.md, 11.5): foreground-сервис типа dataSync держит процесс,
        пока идёт загрузка, и показывает её в уведомлении. Запускается из видимого приложения, по нажатию «отправить».
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 14+: загрузка видео и скачивание обновления идут user-initiated data transfer job (BackgroundTransfer). -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!--
        Обновления изнутри приложения (docs/PROMPT.md, 19.1): магазина нет, APK из GitHub Releases ставит
        сама Искра через PackageInstaller — после проверки хэша и сертификата.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Бэкап выключен целиком (docs/PROMPT.md, 5.1). Это аналог `ThisDeviceOnly` на iOS: зашифрованный
        стор уехал бы в облако, а ключ из Keystore — нет, и восстановленное приложение открылось бы
        с мусором. allowBackup="false" и правила, исключающие всё, и для облака, и для переноса
        с устройства на устройство. Закреплено тестом на собранном манифесте.
    -->
    <application
        android:name=".IskraApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iskra"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- «Поделиться» из других приложений (ShareRouter): слова, один файл или несколько. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!--
                Возврат из браузера после входа: AppEnvironment.OAUTH_REDIRECT_URI. Схема — clientUri
                задом наперёд, иначе сервер с MAS её не примет. singleTask — чтобы вернулась та же activity,
                что ждёт callback. Хоста нет намеренно: адрес возврата ровно такой, каким его ждёт сервер
                (как на iOS), поэтому AppLinkUrlError здесь — не ошибка.
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wtf.iskra" android:path="/oauth-callback" />
            </intent-filter>
            <!--
                Ссылки на людей и комнаты (`MatrixLink`): `matrix:` — схема протокола, `wtf.iskra://u|r|roomid/…` — кнопка
                «Открыть в Искре» на странице s.iskra.wtf, и сама эта страница как App Link. Страница-ссылка и файл
                `assetlinks.json` на ней — у автора: пока он не лежит, https открывается выбором приложения, а не сразу.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="matrix" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wtf.iskra" android:host="u" />
                <data android:scheme="wtf.iskra" android:host="r" />
                <data android:scheme="wtf.iskra" android:host="roomid" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="s.iskra.wtf" />
            </intent-filter>
        </activity>

        <!--
            Восемь иконок на выбор (AppIcons): ровно один alias включён, он и есть значок в лаунчере. MainActivity сама
            в лаунчере не стоит. Включённый — часть состояния пакета, поэтому «какая сейчас» читается у системы, не из настроек.
        -->
        <activity-alias
            android:name="wtf.iskra.IconSpark"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="wtf.iskra.IconChrome"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_chrome"
            android:roundIcon="@mipmap/ic_launcher_chrome"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="wtf.iskra.IconGarnet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_garnet"
            android:roundIcon="@mipmap/ic_launcher_garnet"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="wtf.iskra.IconPine"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pine"
            android:roundIcon="@mipmap/ic_launcher_pine"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="wtf.iskra.IconRio"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rio"
            android:roundIcon="@mipmap/ic_launcher_rio"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="wtf.iskra.IconBlackWhite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_black_white"
            android:roundIcon="@mipmap/ic_launcher_black_white"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="wtf.iskra.IconRetro"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_retro"
            android:roundIcon="@mipmap/ic_launcher_retro"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="wtf.iskra.IconLetters"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_letters"
            android:roundIcon="@mipmap/ic_launcher_letters"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <!--
            «Ответить» и «Прочитано» на уведомлении (PushPresenter). Интенты к нему — с явным компонентом;
            наружу не торчит.
        -->
        <receiver
            android:name="wtf.iskra.features.push.NotificationActionReceiver"
            android:exported="false" />

        <!-- Ответ PackageInstaller на установку обновления (UpdateInstallReceiver). -->
        <receiver
            android:name="wtf.iskra.features.update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Android 14+: то же самое user-initiated data transfer job — система выбирает её для того, что человек начал сам. -->
        <service
            android:name="wtf.iskra.features.media.TransferJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Скачивание обновления, когда ушли из приложения (UpdateService). -->
        <service
            android:name="wtf.iskra.features.update.UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Загрузка видео, альбома и файла, пока человек ушёл из чата (MediaSendService). -->
        <service
            android:name="wtf.iskra.features.media.MediaSendService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Второй заход на пуш, не успевший расшифроваться, пока ждал транспорт (PushRetryJob). -->
        <service
            android:name="wtf.iskra.features.push.PushRetryJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            Присланный файл, открытый в другом приложении (FileOpener): только cache/opened, только на
            чтение и только тому, кому выдан интент. Наружу провайдер не торчит.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Виджет «Избранные чаты» (Glance): снимок пишет сеанс (WidgetPublisher), нажатие открывает чат. -->
        <receiver
            android:name="wtf.iskra.features.widget.FavouritesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_favourites_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/favourites_widget_info" />
        </receiver>
    </application>
</manifest>
