<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Голосовые (docs/PROMPT.md, 11.3): спрашивается при первой записи, не при запуске. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
        Кружки (docs/PROMPT.md, 11.4): камера для записи видеосообщения, спрашивается при первой записи.
        Не обязательна: без камеры приложение ставится и работает, кружок просто нечем записать.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <!-- «Место»: одна точка по просьбе человека, из видимого приложения. Фоновой геопозиции нет. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Уведомления (docs/PROMPT.md, 10.5): спрашивается после первого входа, не на экране входа. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Обновления изнутри приложения (docs/PROMPT.md, 19.1): магазина нет, APK из GitHub Releases ставит
        сама Искра через PackageInstaller — после проверки хэша и сертификата.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Бэкап выключен целиком (docs/PROMPT.md, 5.1). Это аналог `ThisDeviceOnly` на iOS: зашифрованный
        стор уехал бы в облако, а ключ из Keystore — нет, и восстановленное приложение открылось бы
        с мусором. allowBackup="false" и правила, исключающие всё, и для облака, и для переноса
        с устройства на устройство. Закреплено тестом на собранном манифесте.
    -->
    <application
        android:name=".IskraApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iskra"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Возврат из браузера после входа: AppEnvironment.OAUTH_REDIRECT_URI. Схема — clientUri
                задом наперёд, иначе сервер с MAS её не примет. singleTask — чтобы вернулась та же activity,
                что ждёт callback. Хоста нет намеренно: адрес возврата ровно такой, каким его ждёт сервер
                (как на iOS), поэтому AppLinkUrlError здесь — не ошибка.
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wtf.iskra" android:path="/oauth-callback" />
            </intent-filter>
        </activity>

        <!--
            «Ответить» и «Прочитано» на уведомлении (PushPresenter). Интенты к нему — с явным компонентом;
            наружу не торчит.
        -->
        <receiver
            android:name="wtf.iskra.features.push.NotificationActionReceiver"
            android:exported="false" />

        <!-- Ответ PackageInstaller на установку обновления (UpdateInstallReceiver). -->
        <receiver
            android:name="wtf.iskra.features.update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Второй заход на пуш, не успевший расшифроваться, пока ждал транспорт (PushRetryJob). -->
        <service
            android:name="wtf.iskra.features.push.PushRetryJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            Присланный файл, открытый в другом приложении (FileOpener): только cache/opened, только на
            чтение и только тому, кому выдан интент. Наружу провайдер не торчит.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
