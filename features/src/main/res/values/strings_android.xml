<?xml version="1.0" encoding="utf-8"?>
<!-- Строки, нужные только Android (CLAUDE.md). Знаки, которые не переводятся, — translatable="false". -->
<resources>
    <!-- Упоминание рядом со значком непрочитанного: «@», как на iOS. -->
    <string name="room_list_mention_mark" translatable="false">@</string>
    <!-- Действие от третьего лица (`/me`): «* Аня машет рукой». Знаки, не слова. -->
    <string name="room_emote" translatable="false">* %1$s %2$s</string>
    <!-- Пилюля реакции: эмодзи и сколько человек его поставили. -->
    <string name="room_reaction_pill" translatable="false">%1$s %2$d</string>
    <!-- Две части одной строки через точку: «Опрос · несколько ответов», «3 голоса · итоги в конце». -->
    <string name="poll_header_joined" translatable="false">%1$s · %2$s</string>
    <!-- Координаты места под его названием: числа, не слова. -->
    <string name="location_coordinates" translatable="false">%1$.5f, %2$.5f</string>
    <!-- Скорость видео: «1,5×». Число — по локали, знак не переводится. -->
    <string name="video_rate" translatable="false">%1$s×</string>
    <!-- Сколько осталось до конца видео: «−0:42», как на iOS. -->
    <string name="video_remaining" translatable="false">−%1$s</string>
</resources>
