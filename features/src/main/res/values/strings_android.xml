<?xml version="1.0" encoding="utf-8"?>
<!-- Строки, нужные только Android (CLAUDE.md). Знаки, которые не переводятся, — translatable="false". -->
<resources>
    <!-- Упоминание рядом со значком непрочитанного: «@», как на iOS. -->
    <string name="room_list_mention_mark" translatable="false">@</string>
    <!-- Действие от третьего лица (`/me`): «* Аня машет рукой». Знаки, не слова. -->
    <string name="room_emote" translatable="false">* %1$s %2$s</string>
    <!-- Пилюля реакции: эмодзи и сколько человек его поставили. -->
    <string name="room_reaction_pill" translatable="false">%1$s %2$d</string>
    <!-- Две части одной строки через точку: «Опрос · несколько ответов», «3 голоса · итоги в конце». -->
    <string name="poll_header_joined" translatable="false">%1$s · %2$s</string>
    <!-- Координаты места под его названием: числа, не слова. -->
    <string name="location_coordinates" translatable="false">%1$.5f, %2$.5f</string>
    <!-- Скорость видео: «1,5×». Число — по локали, знак не переводится. -->
    <string name="video_rate" translatable="false">%1$s×</string>
    <!-- Сколько осталось до конца видео: «−0:42», как на iOS. -->
    <string name="video_remaining" translatable="false">−%1$s</string>
    <!-- Экран восстановления: копию сделало другое устройство, кода к ней нет. В iOS этой развилки пока нет. -->
    <string name="recovery_elsewhere_title">Your account already has a backup</string>
    <string name="recovery_elsewhere_has_devices">It was made on another device, and there’s no recovery code for it — so this device can’t open your earlier messages yet. Confirm this device from a phone or computer where you’re already signed in, and we’ll give you a recovery code.</string>
    <string name="recovery_elsewhere_alone">It was made on another device, and there’s no recovery code for it. Without that device your old messages can’t come back — they stay encrypted for good. New messages will arrive as usual, and we’ll give you a recovery code.</string>
    <!-- «+» в композере: камера системным приложением. На iOS камера — только у кружочков, общей строки нет. -->
    <string name="room_attach_take_photo">Take a photo</string>
    <string name="room_attach_record_video">Record a video</string>
    <!-- Канал уведомлений для пушей, которые не расшифровались: «Iskra · Новое сообщение». -->
    <string name="notification_channel_other">Other messages</string>
</resources>
